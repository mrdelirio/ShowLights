@page "/channels"
@rendermode InteractiveWebAssembly

<PageTitle>Channels</PageTitle>

<h1>DMX Channels</h1>

<div class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">Universe</label>
        <input type="number" class="form-control" min="0" max="32767" @bind="universe" />
    </div>
    <div class="col-auto">
        <label class="form-label">Channels</label>
        <input type="number" class="form-control" min="1" max="512" @bind="channelCount" @bind:event="oninput" @onchange="OnChannelCountChanged" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="LoadPatch">Load Patch</button>
    </div>
</div>

<div class="row g-2">
    @for (var i = 1; i <= channelCount; i++)
    {
        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
            <div class="card p-2 text-center">
                <label>Ch @i</label>
                <input type="range" min="0" max="255" value="@channelValues[i-1]" @oninput="(e)=>OnChannelChanged(i-1, e)" class="form-range" />
                <div>@channelValues[i-1]</div>
            </div>
        </div>
    }
    <div class="col-12 mt-2">
        <button class="btn btn-primary" @onclick="SendFrame">Invia Frame Art-Net</button>
    </div>
</div>

@code {
    private int universe = 0;
    private int channelCount = 16;
    private byte[] channelValues = new byte[16];

    private void OnChannelChanged(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < channelValues.Length && byte.TryParse(Convert.ToString(e.Value), out var v))
        {
            channelValues[index] = v;
        }
    }

    private void OnChannelCountChanged()
    {
        if (channelCount > 0 && channelCount <= 512)
        {
            var newValues = new byte[channelCount];
            var copyLength = Math.Min(channelValues.Length, channelCount);
            Array.Copy(channelValues, newValues, copyLength);
            channelValues = newValues;
        }
    }

    [Inject] private HttpClient Http { get; set; } = default!;

    private async Task SendFrame()
    {
        var payload = new { universe, values = channelValues };
        await Http.PostAsJsonAsync("http://localhost:5178/api/artnet/send", payload);
    }

    private async Task LoadPatch()
    {
        var state = await Http.GetFromJsonAsync<AppStateDto>("http://localhost:5178/api/state");
        var patch = state?.Patches?.FirstOrDefault(p => p.Universe == universe);
        if (patch != null)
        {
            channelCount = Math.Clamp(patch.ActiveChannels, 1, 512);
            OnChannelCountChanged();
        }
    }

    private sealed class AppStateDto { public List<PatchDto>? Patches { get; set; } }
    private sealed class PatchDto { public int Universe { get; set; } public int ActiveChannels { get; set; } }
}

